# From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number people call (and the number texts are sent from)
TWILIO_PHONE_NUMBER=+15551234567

# Your real cell phone. Calls are forwarded here first.
FORWARD_TO_NUMBER=+15557654321

# How many seconds to ring your cell before it counts as missed
RING_TIMEOUT_SECONDS=20

# The text sent to callers you miss
AUTO_REPLY_MESSAGE=Hi, sorry I missed your call! I'm currently busy and I will get back to you as soon as I can.

# Your business hours (24-hour clock). Days not listed are closed.
BUSINESS_HOURS=Mon-Fri 10:30-19:00; Sat 10:30-17:00

# Your time zone, e.g. America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TIMEZONE=America/New_York

# The text sent to anyone who calls outside your business hours
AFTER_HOURS_MESSAGE=Thanks for your message! I'm currently outside business hours and not available by call or text. My hours are Mon–Fri 10:30 AM–7:00 PM and Sat 10:30 AM–5:00 PM (closed Sunday). I'll get back to you during business hours.

# Don't text the same number more than once in this many hours
COOLDOWN_HOURS=12

PORT=3000
